{
  "name": "touchpress-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for touchpress, end-to-end testing for mobile apps with the Playwright test runner.",
  "type": "module",
  "scripts": {
    "check": "vp check",
    "test": "vp test",
    "build": "vp run -r build",
    "test:e2e": "pnpm --filter touchpress-e2e test:e2e",
    "test:e2e:vitest": "pnpm --filter touchpress-e2e test:e2e:vitest",
    "prepare": "vp config",
    "release": "vp exec changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
