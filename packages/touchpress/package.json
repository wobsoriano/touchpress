{
  "name": "touchpress",
  "version": "0.2.2",
  "description": "End-to-end testing for mobile apps.",
  "keywords": [
    "android",
    "automation",
    "e2e",
    "ios",
    "testing"
  ],
  "homepage": "https://github.com/wobsoriano/touchpress#readme",
  "bugs": {
    "url": "https://github.com/wobsoriano/touchpress/issues"
  },
  "license": "MIT",
  "author": "Robert Soriano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wobsoriano/touchpress.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./core": "./dist/core/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "agent-device": "0.21.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "ai": "^7.0.93",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.63",
    "ai": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
